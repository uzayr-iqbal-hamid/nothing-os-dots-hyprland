# Nothing theme for btop: white on black, greys for structure, red only for danger (hot temps, highlighted keys).
# Colours mirror ~/.config/quickshell/nothing/Theme.qml.
theme[main_bg]="#000000"
theme[main_fg]="#FFFFFF"
theme[title]="#FFFFFF"
theme[hi_fg]="#D71921"
theme[selected_bg]="#FFFFFF"
theme[selected_fg]="#000000"
theme[inactive_fg]="#5A5A5A"
theme[graph_text]="#8C8C8C"
theme[meter_bg]="#3A3A3A"
theme[proc_misc]="#8C8C8C"
theme[cpu_box]="#4A4A4A"
theme[mem_box]="#4A4A4A"
theme[net_box]="#4A4A4A"
theme[proc_box]="#4A4A4A"
theme[div_line]="#2E2E2E"
theme[temp_start]="#8C8C8C"
theme[temp_mid]="#BDBDBD"
theme[temp_end]="#D71921"
theme[cpu_start]="#5A5A5A"
theme[cpu_mid]="#BDBDBD"
theme[cpu_end]="#FFFFFF"
theme[free_start]="#3A3A3A"
theme[free_mid]="#5A5A5A"
theme[free_end]="#8C8C8C"
theme[cached_start]="#5A5A5A"
theme[cached_mid]="#8C8C8C"
theme[cached_end]="#BDBDBD"
theme[available_start]="#3A3A3A"
theme[available_mid]="#5A5A5A"
theme[available_end]="#8C8C8C"
theme[used_start]="#8C8C8C"
theme[used_mid]="#BDBDBD"
theme[used_end]="#FFFFFF"
theme[download_start]="#5A5A5A"
theme[download_mid]="#BDBDBD"
theme[download_end]="#FFFFFF"
theme[upload_start]="#5A5A5A"
theme[upload_mid]="#8C8C8C"
theme[upload_end]="#BDBDBD"
theme[process_start]="#5A5A5A"
theme[process_mid]="#BDBDBD"
theme[process_end]="#FFFFFF"
