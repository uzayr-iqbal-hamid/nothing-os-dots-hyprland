/* NOTHING-SHELL: app drawer for Super+D. Builds on nothing.rasi (the list theme every KooL menu
   uses) and turns drun into an icon grid: monochrome icons, Lettera labels, white pill selection. */

@import "~/.config/rofi/nothing.rasi"

configuration {
    modi:                "drun";
    show-icons:          true;
    icon-theme:          "Nothing-Mono";
    display-drun:        "";
    drun-display-format: "{name}";
}

window {
    width:            780px;
}

mainbox {
    children:         [ "inputbar", "listview" ];
    spacing:          16px;
    padding:          20px;
}

inputbar {
    children:         [ "entry" ];
    padding:          12px 22px;
}

listview {
    columns:          6;
    lines:            3;
    flow:             horizontal;
    layout:           vertical;
    fixed-columns:    true;
    fixed-height:     true;
    spacing:          6px;
    padding:          6px 0px;
}

element {
    orientation:      vertical;
    spacing:          10px;
    padding:          16px 6px 12px 6px;
    border-radius:    20px;
}

element-icon {
    size:             48px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    font:             "Lettera Mono LL 9";
}
